{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "🏷️ Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "descrtion": {
      "type": "blocks",
      "required": false
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "photo": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "time": {
      "type": "datetime"
    }
  }
}
